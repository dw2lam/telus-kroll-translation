{
  "name": "telus-kroll-translation-demo",
  "productName": "Telus Kroll Translation Demo",
  "version": "0.1.4",
  "description": "Deterministic sig-translation engine and desktop app for TELUS Health Kroll prescription labels.",
  "author": "David Lam",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --mac --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "test:e2e": "npm run build && node tests/e2e/flow.e2e.mjs",
    "release": "npm run typecheck && npm test && npm run build && rm -rf dist && electron-builder --mac --win --publish never && gh release create v$npm_package_version --repo dw2lam/telus-kroll-translation --target main --title \"Telus Kroll Translation Demo $npm_package_version\" --generate-notes dist/*.dmg dist/*.exe"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dw2lam/telus-kroll-translation.git"
  },
  "homepage": "https://github.com/dw2lam/telus-kroll-translation"
}
